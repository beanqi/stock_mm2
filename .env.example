# Copy to .env and fill in. Keys are never accepted from the UI.
BINANCE_API_KEY=
BINANCE_API_SECRET=
GATE_API_KEY=
GATE_API_SECRET=

# testnet | mainnet
TRADING_ENV=testnet

API_LISTEN=127.0.0.1:8080
DATABASE_URL=sqlite://data/mm.db
RUST_LOG=stock_mm=info,warn
WEB_DIR=web/dist

# Console login: password + TOTP (Google Authenticator / 1Password / Bitwarden).
# Leave AUTH_PASSWORD empty to auto-generate once (written to data/initial-password.txt).
AUTH_USERNAME=admin
AUTH_PASSWORD=
# AUTH_TOTP_SECRET=
# AUTH_DISABLED=1
# AUTH_RESET_TOTP=1
# AUTH_COOKIE_SECURE=1
# AUTH_SESSION_SECRET=
